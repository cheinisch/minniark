# Minniark .gitignore

# User content and configuration (contains password hashes, API keys, settings)
userdata/config/
userdata/content/
userdata/template/

# Backups
backup/

# Image and page cache
cache/images/
cache/pages/

# Composer dependencies
vendor/

# Upload log (generated at runtime)
api/upload_log.txt

# Environment / local overrides
.env
.env.local

# OS and editor artefacts
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# PHP error logs
*.log
